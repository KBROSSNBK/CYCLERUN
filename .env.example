# ---------------------------------------------------------------------------
# CYCLERUN - variables de entorno
# Copia este archivo como .env y rellena los valores de tu proyecto Firebase.
# (Consola de Firebase -> Configuracion del proyecto -> Tus apps -> Web)
#
# Si dejas estas variables vacias la aplicacion arranca igualmente en
# "modo local": las carreras se guardan solo en el dispositivo (IndexedDB).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ruta base del despliegue. Solo necesario para builds locales de produccion.
# En GitHub Pages el workflow la calcula sola a partir del nombre del repo.
# VITE_BASE_PATH=/CYCLERUN/
