{
  "name": "cyclerun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Registra tus carreras en bicicleta mediante GPS.",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --project demo-cyclerun --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "firebase": "^11.10.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
